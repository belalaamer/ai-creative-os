NEXT_PUBLIC_SUPABASE_URL=https://qsyjddhfzahhdwmkcbiv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
# Server-only provider keys are added later; never expose them with NEXT_PUBLIC_ prefixes.
APP_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=
BILLING_PROVIDER_SECRET=

# Phase 10: keep OpenAI provider secrets inside Supabase Edge Functions.
# Set these as Supabase project secrets, not in the browser bundle:
# OPENAI_API_KEY=
# OPENAI_TEXT_MODEL=
# OPENAI_TEXT_INPUT_COST_PER_MILLION_USD=
# OPENAI_TEXT_OUTPUT_COST_PER_MILLION_USD=
# The web app only needs this server-side switch to route text generation through the Edge Function:
USE_SUPABASE_OPENAI_TEXT=false

# Phase 11 — secure media gateways (web feature flags only)
USE_SUPABASE_OPENAI_IMAGE=true
USE_SUPABASE_OPENAI_SPEECH=true
